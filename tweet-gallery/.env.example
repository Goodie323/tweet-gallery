# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # keep secret, server-only

# Your own admin password for /admin
ADMIN_PASSWORD=choose-a-strong-password

# Random secret used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-64-char-hex-string
